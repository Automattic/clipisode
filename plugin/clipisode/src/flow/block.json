{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "clipisode/invitation-flow",
	"title": "Clipisode Invitation Flow",
	"category": "widgets",
	"icon": "video-alt3",
	"description": "Parent container for the multi-step invitation flow. Contains landing, record, and thanks stages as sub-blocks.",
	"attributes": {
		"slug": {
			"type": "string",
			"default": ""
		}
	},
	"providesContext": {
		"clipisode/slug": "slug"
	},
	"supports": {
		"html": false,
		"multiple": false
	},
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"style": "file:./view.css",
	"render": "file:./render.php"
}
