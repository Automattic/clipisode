{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "clipisode/element",
	"title": "Clipisode Element",
	"category": "widgets",
	"icon": "screenoptions",
	"description": "A single invitation element. Content is locked (from DB); styles are editable. Drag to reorder within a stage.",
	"parent": [
		"clipisode/invitation-landing",
		"clipisode/invitation-record",
		"clipisode/invitation-thanks"
	],
	"usesContext": [ "clipisode/slug" ],
	"attributes": {
		"type": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"reusable": false,
		"color": {
			"text": true,
			"background": true,
			"gradients": true
		},
		"typography": {
			"fontSize": true,
			"fontFamily": true,
			"lineHeight": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
