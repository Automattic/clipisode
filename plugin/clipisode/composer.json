{
	"name": "clipisode/clipisode",
	"description": "Clipisode WordPress plugin",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^9",
		"wp-phpunit/wp-phpunit": "^6.7",
		"yoast/phpunit-polyfills": "^3.0",
		"php-stubs/wordpress-stubs": "^6.7",
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.1",
		"automattic/vipwpcs": "^3.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload-dev": {
		"psr-4": {
			"Clipisode\\Tests\\": "tests/phpunit/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"test:coverage": "phpunit --coverage-html coverage",
		"lint": "phpcs",
		"lint:summary": "phpcs --report=summary",
		"lint:sniffs": "phpcs --report=source",
		"lint:fix": "phpcbf"
	},
	"scripts-descriptions": {
		"lint": "VIP-readiness lint (advisory — deliberately not part of `test`).",
		"lint:summary": "Violation counts per file.",
		"lint:sniffs": "Violation counts per sniff. The useful view for triage.",
		"lint:fix": "Auto-fix the mechanically fixable subset."
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
