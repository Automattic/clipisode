#!/bin/sh

set -e

require_version() {
	if ! printf '%s' "$1" | tr '\n' ' ' |
		grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
		echo "Error: '$1' in $2 is not a major.minor.patch version" >&2
		exit 1
	fi
}

replace_version() {
	sed -i.bak "$2" "$1"

	if cmp -s "$1" "$1.bak"; then
		rm "$1.bak"
		echo "Error: nothing matched '$2' in $1" >&2
		exit 1
	fi

	rm "$1.bak"
}

increment_version() {
	version=$1
	release=$2

	major=$(echo "$version" | cut -d. -f1)
	minor=$(echo "$version" | cut -d. -f2)
	patch=$(echo "$version" | cut -d. -f3)

	case $release in
		major)
			major=$((major + 1))
			minor=0
			patch=0
			;;
		minor)
			minor=$((minor + 1))
			patch=0
			;;
		patch)
			patch=$((patch + 1))
			;;
		*)
			echo "Invalid release type. Use 'major', 'minor', or 'patch'." >&2
			exit 1
			;;
	esac

	echo "${major}.${minor}.${patch}"
}

if [ $# -eq 0 ]; then
	echo "Please provide a release type: major, minor, or patch" >&2
	exit 1
fi

release_type=$1
php_file="clipisode.php"
current_version=$(sed -n "s/.*Version: \([0-9.]*\).*/\1/p" "$php_file")
require_version "$current_version" "$php_file"
new_version=$(increment_version "$current_version" "$release_type")

replace_version "$php_file" "s/Version: $current_version/Version: $new_version/"
replace_version "$php_file" \
	"s/define( 'CLIPISODE_VERSION', '$current_version' );/define( 'CLIPISODE_VERSION', '$new_version' );/"

echo "Updated $php_file from $current_version to $new_version"

package_file="package.json"
package_lock_file="package-lock.json"
current_version_pkg=$(sed -n 's/.*"version": "\([0-9.]*\)".*/\1/p' "$package_file")
require_version "$current_version_pkg" "$package_file"

replace_version "$package_file" \
	"s/\"version\": \"$current_version_pkg\"/\"version\": \"$new_version\"/"

npm install

git checkout -b release/v"$new_version"
git add "$php_file" "$package_file" "$package_lock_file"
git commit -m "v$new_version"

echo "Changes committed to release/v$new_version."
